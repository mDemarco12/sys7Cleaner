{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sys7 Cleaner",
  "version": "0.1.0",
  "identifier": "com.mdemarco12.sys7cleaner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "sys7 HD Cleanup Utility",
        "width": 640,
        "height": 480,
        "resizable": true,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "sys7 Cleaner Dev"
    }
  }
}
